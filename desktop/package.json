{
  "name": "earful-desktop",
  "productName": "Earful",
  "version": "1.6.2",
  "description": "Your music, uninterrupted.",
  "author": "Earful",
  "homepage": "https://github.com/BeshoyAdeI/earful",
  "desktopName": "earful.desktop",
  "private": true,
  "main": "dist/main.mjs",
  "scripts": {
    "bundle": "node scripts/bundle.mjs",
    "start": "pnpm --filter @earful/web build && node scripts/bundle.mjs && electron .",
    "dist": "pnpm --filter @earful/web build && node scripts/bundle.mjs && electron-builder --win nsis --publish never && node scripts/collect-updates.mjs",
    "dist:mac": "pnpm --filter @earful/web build && node scripts/bundle.mjs && electron-builder --mac --publish never",
    "dist:linux": "pnpm --filter @earful/web build && node scripts/bundle.mjs && electron-builder --linux --publish never",
    "typecheck": "tsc --noEmit"
  },
  "build": {
    "appId": "com.beshoy.earful.desktop",
    "productName": "Earful",
    "copyright": "Earful",
    "directories": {
      "output": "out",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web"
      }
    ],
    "artifactBuildCompleted": "build/collect.cjs",
    "asar": true,
    "npmRebuild": false,
    "fileAssociations": [
      {
        "ext": "earful",
        "name": "Earful Playlist",
        "description": "Earful playlist",
        "role": "Viewer",
        "mimeType": "application/x-earful-playlist"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Earful-Setup-${version}-Windows.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon-mac.png",
      "category": "public.app-category.music",
      "minimumSystemVersion": "12.0",
      "darkModeSupport": true,
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "executableName": "earful",
      "syncDesktopName": true,
      "category": "AudioVideo",
      "synopsis": "Your music, uninterrupted.",
      "description": "A personal music player for YouTube's catalog: songs and music videos, with no ads and no account.",
      "maintainer": "Earful <https://github.com/BeshoyAdeI/earful>"
    },
    "deb": {
      "packageName": "earful"
    },
    "dmg": {
      "title": "Earful ${version}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Earful",
      "runAfterFinish": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerLanguages": [
        "en_US",
        "pt_BR"
      ],
      "language": "1033",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "BeshoyAdeI",
        "repo": "earful",
        "releaseType": "release"
      }
    ]
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  }
}
